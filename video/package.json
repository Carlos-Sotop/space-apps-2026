{
  "name": "spacedao-video",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "SpaceDAO 30-second demo video (NASA Space Apps 2026)",
  "scripts": {
    "studio": "node scripts/assets.mjs && remotion studio src/index.ts",
    "assets": "node scripts/assets.mjs",
    "render": "node scripts/assets.mjs && node scripts/make-vtt.mjs && remotion render src/index.ts SpaceDAO30 out/spacedao-30s.mp4 --codec=h264 --crf=16 --audio-bitrate=320k --concurrency=4 --timeout=120000",
    "capture": "node capture/capture.mjs",
    "vtt": "node scripts/make-vtt.mjs",
    "vtt180": "node scripts/make-vtt.mjs 180",
    "render180": "node scripts/assets.mjs && node scripts/make-vtt.mjs 180 && remotion render src/index.ts SpaceDAO180 out/spacedao-3min.mp4 --codec=h264 --crf=16 --audio-bitrate=320k --concurrency=4 --timeout=120000"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "@remotion/cli": "4.0.542",
    "@remotion/google-fonts": "4.0.542",
    "@remotion/noise": "4.0.542",
    "@remotion/three": "4.0.542",
    "motion": "14.14.0",
    "postprocessing": "6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542",
    "three": "0.187.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "playwright": "^1.50.0",
    "typescript": "^5.3.0"
  }
}
